pkgname=minidm
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal TUI display manager"
arch=('x86_64')
url="https://github.com/r4ppz/minidm"
license=('MIT')
depends=('pam' 'glibc')
makedepends=('go')
source=("${pkgname}::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname"
	export CGO_ENABLED=1
	export GOFLAGS="-trimpath -buildvcs=false"
	make build
}

package() {
	cd "$srcdir/$pkgname"
	install -Dm755 bin/minidm "$pkgdir/usr/bin/minidm"
	install -Dm644 package/minidm.service "$pkgdir/usr/lib/systemd/system/minidm.service"
	install -Dm644 package/pam.d/minidm "$pkgdir/etc/pam.d/minidm"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
