[Unit]
Description=Mini Display Manager
After=systemd-user-sessions.service getty@tty1.service
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/minidm
Restart=on-failure
RestartSec=1
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty

[Install]
WantedBy=graphical.target
